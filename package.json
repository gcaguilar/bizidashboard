{
  "name": "bizidashboard",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "imports": {
    "#/*": "./src/*",
    "@/*": "./src/*"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "rm -rf dist .output && vite build",
    "preview": "vite preview",
    "start": "bun ops/start-server.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "db:health": "tsx scripts/db-health-check.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:backfill:daily-system": "tsx scripts/backfill-daily-system-stat.ts",
    "qa:seed": "tsx scripts/seed-qa-db.ts",
    "qa:audit": "bun scripts/site-audit.ts",
    "qa:audit:check": "bun scripts/check-site-audit.ts",
    "qa:security:smoke": "node scripts/security-smoke.mjs",
    "qa:validate:site-env": "node scripts/validate-site-env.mjs",
    "qa:vitals:prod": "node scripts/collect-dashboard-vitals.mjs",
    "qa:vitals:check": "node scripts/check-dashboard-vitals.mjs",
    "qa:ci:local": "./scripts/run-local-ci.sh",
    "qa:audit:prod": "bun scripts/site-audit.ts --base-url https://datosbizi.com --output ops/site-audit-report-prod.json",
    "social:preview": "bun scripts/social-preview.ts",
    "social:discover": "bun scripts/social-discover.ts",
    "social:status": "bun scripts/social-status.ts",
    "security:audit": "bun audit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/replay": "11.10.0",
    "@sentry/tanstackstart-react": "^11.10.0",
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "html2pdf.js": "^0.14.0",
    "jose": "^6.2.15",
    "jpeg-js": "^0.4.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "maplibre-gl": "^6.16.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "^8.1.3",
    "recharts": "^3.10.1",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query-devtools": "^5.105.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "proj4": "^2.22.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "valibot": "1.5.0"
  }
}
