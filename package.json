{
  "name": "bizidashboard",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "imports": {
    "#/*": "./src/*",
    "@/*": "./src/*"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.10"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- vite dev --port 3000",
    "build": "rm -rf dist .output && vite build",
    "preview": "vite preview",
    "start": "bun ops/start-server.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "db:health": "tsx scripts/db-health-check.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "qa:seed": "tsx scripts/seed-qa-db.ts",
    "qa:audit": "bun scripts/site-audit.ts",
    "qa:audit:check": "bun scripts/check-site-audit.ts",
    "qa:security:smoke": "node scripts/security-smoke.mjs",
    "qa:validate:site-env": "node scripts/validate-site-env.mjs",
    "qa:vitals:prod": "node scripts/collect-dashboard-vitals.mjs",
    "qa:vitals:check": "node scripts/check-dashboard-vitals.mjs",
    "qa:ci:local": "./scripts/run-local-ci.sh",
    "qa:audit:prod": "bun scripts/site-audit.ts --base-url https://datosbizi.com --output ops/site-audit-report-prod.json",
    "security:audit": "bun audit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/tanstackstart-react": "^10.69.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@tanstack/start-plugin": "latest",
    "jose": "^6.2.8",
    "maplibre-gl": "^5.24.0",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-map-gl": "^8.1.2",
    "recharts": "^3.10.1",
    "redis": "^6.2.0",
    "server-only": "^0.0.1",
    "vite-plugin-neon-new": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^28.1.0",
    "prisma": "^7.9.1",
    "proj4": "^2.21.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "overrides": {
    "lodash": "4.17.23",
    "hono": "4.12.7",
    "@hono/node-server": "1.19.10"
  }
}
