# Your Sentry DSN (from your Sentry account)
VITE_SENTRY_DSN=
SENTRY_DSN=
VITE_SENTRY_TRACE_SAMPLE_RATE=0.2
SENTRY_DYNACONF_RELEASE=0.0.1

# Browser analytics (read by the server at runtime)
UMAMI_SCRIPT_SRC=https://cloud.umami.is/script.js
UMAMI_WEBSITE_ID=
UMAMI_HOST_URL=https://api-gateway.umami.dev

# Runtime security
APP_URL=http://localhost:3000
MOBILE_API_ENABLED=false
MOBILE_API_ALLOWED_ORIGINS=
REQUIRE_SIGNED_MOBILE_REQUESTS=false
CSP_REPORT_ONLY=true
CSP_SCRIPT_SRC_ORIGINS=
CSP_CONNECT_SRC_ORIGINS=

# Required in production (startup fails without these — see src/lib/security/config.ts)
# Sign/verify mobile install JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=
# Sign/verify mobile request HMAC signatures. Generate with: openssl rand -base64 32
SIGNATURE_SECRET=
# Shared secret for X-Ops-Api-Key on /api/collect and /api/ops/*.
OPS_API_KEY=
COLLECT_API_KEY=
# Shared rate-limit state and cache coordination
REDIS_URL=

# Optional: X-Public-Api-Key for elevated public read endpoints (CSV exports, high limits)
PUBLIC_API_KEY=

# Auth0 (third-party OAuth for the public API — see "Operational Security & API Access" in README)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Auth0 developer login (Regular Web Application) — self-service API client registration at /developers
AUTH0_LOGIN_CLIENT_ID=
AUTH0_LOGIN_CLIENT_SECRET=
# Random string, min 32 chars, used to encrypt the developer login session cookie
SESSION_SECRET=

# Your Sentry organization (from your Sentry account)
# VITE_SENTRY_ORG=
# VITE_SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"
