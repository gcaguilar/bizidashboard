# Your Sentry DSN (from your Sentry account)
VITE_SENTRY_DSN=
SENTRY_DSN=
VITE_SENTRY_TRACE_SAMPLE_RATE=0.2
SENTRY_DYNACONF_RELEASE=0.0.1

# Browser analytics (read by the server at runtime)
UMAMI_SCRIPT_SRC=https://cloud.umami.is/script.js
UMAMI_WEBSITE_ID=
UMAMI_HOST_URL=https://api-gateway.umami.dev

# Runtime security
# Use https://datosbizi.com in the production deployment (Auth0 callback/origin).
APP_URL=http://localhost:3000
# Explicit public origin used for Auth0 callback and logout URLs.
AUTH0_PUBLIC_ORIGIN=https://datosbizi.com
MOBILE_API_ENABLED=false
MOBILE_API_ALLOWED_ORIGINS=
REQUIRE_SIGNED_MOBILE_REQUESTS=false
CSP_REPORT_ONLY=true
CSP_SCRIPT_SRC_ORIGINS=
CSP_CONNECT_SRC_ORIGINS=https://mcp.datosbizi.com

# Required in production (startup fails without these — see src/lib/security/config.ts)
# Sign/verify mobile install JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=
# Salt used for security-event hashes (and retained for backwards-compatible configuration)
SIGNATURE_SECRET=
# Shared secret for X-Ops-Api-Key on /api/collect and /api/ops/*.
OPS_API_KEY=
COLLECT_API_KEY=
# Shared rate-limit state and cache coordination
REDIS_URL=

# Auth0 developer login (Regular Web Application) — developers log in at /developers
# and mint their own x-api-key. See "Operational Security & API Access" in README.
AUTH0_DOMAIN=
AUTH0_LOGIN_CLIENT_ID=
AUTH0_LOGIN_CLIENT_SECRET=
# Auth0 API identifier requested as the access-token audience (server-only)
AUTH0_AUDIENCE=https://api.datosbizi.com
# Comma-separated direct OAuth clients accepted at the API boundary.
AUTH0_ACCESS_TOKEN_ALLOWED_CLIENT_IDS=
# Additional single client ID for the MCP Custom API Client that performs the
# Auth0 On-Behalf-Of exchange. Do not put its secret in this application.
MCP_AUTH0_OBO_CLIENT_ID=
# Random string, min 32 chars, used to encrypt the developer login session cookie
SESSION_SECRET=

# Your Sentry organization (from your Sentry account)
# VITE_SENTRY_ORG=
# VITE_SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"
