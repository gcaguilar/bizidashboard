# Your Sentry DSN (from your Sentry account)
VITE_SENTRY_DSN=
SENTRY_DSN=
VITE_SENTRY_TRACE_SAMPLE_RATE=0.2
SENTRY_TRACE_SAMPLE_RATE=0.2
# Optional: overrides the auto-detected environment (production/staging/...)
APP_ENV=
# Build release identifier. Falls back to GIT_SHA in CI/Docker builds.
SENTRY_DYNACONF_RELEASE=0.0.1
# Session Replay sampling (client only)
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.05
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# Opt-in structured logs forwarded to Sentry Logs (default: disabled)
SENTRY_LOGS_ENABLED=false
VITE_SENTRY_LOGS_ENABLED=false

# Browser analytics (read by the server at runtime)
UMAMI_SCRIPT_SRC=https://cloud.umami.is/script.js
UMAMI_WEBSITE_ID=
UMAMI_HOST_URL=https://api-gateway.umami.dev

# Mapa (cliente). Por defecto no hacen falta claves: OSM para el tema claro y el
# estilo vectorial oscuro de OpenFreeMap para el oscuro. Para usar un proveedor
# propio (CARTO, MapTiler, Stadia...) define VITE_MAP_STYLE_URL_DARK con su URL
# de estilo, o VITE_MAP_TILE_URLS_DARK para forzar teselas raster. Las listas de
# teselas aceptan varias URLs separadas por comas para rotar subdominios.
# Recuerda anadir sus origenes a CSP_CONNECT_SRC_ORIGINS (las teselas vectoriales
# y los glifos pasan por connect-src; las raster por img-src).
VITE_MAP_STYLE_URL_DARK=
VITE_MAP_TILE_URLS_LIGHT=
VITE_MAP_TILE_URLS_DARK=
VITE_MAP_TILE_ATTRIBUTION_LIGHT=
VITE_MAP_TILE_ATTRIBUTION_DARK=
VITE_MAP_GLYPHS_URL=

# Runtime security
# Use https://datosbizi.com in the production deployment (Auth0 callback/origin).
APP_URL=http://localhost:3000
# Origin que usa el job de sellado para pedir el PDF del informe a la web
# (en Docker: http://<servicio-web>:3000; en produccion, la URL publica).
# Si se omite, el servidor web genera el PDF bajo demanda en la primera descarga.
REPORT_PDF_BASE_URL=
# Explicit public origin used for Auth0 callback and logout URLs.
AUTH0_PUBLIC_ORIGIN=https://datosbizi.com
MOBILE_API_ENABLED=false
MOBILE_API_ALLOWED_ORIGINS=
CSP_REPORT_ONLY=true
CSP_SCRIPT_SRC_ORIGINS=
CSP_CONNECT_SRC_ORIGINS=https://mcp.datosbizi.com
# Origins extra permitidos en iframes (el formulario de feedback Tally ya se
# añade automáticamente; usa esto solo para proveedores embebidos adicionales).
CSP_FRAME_SRC_ORIGINS=

# Required in production (startup fails without these — see src/lib/security/config.ts)
# Sign/verify mobile install JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=
# Salt used for security-event hashes (and retained for backwards-compatible configuration)
SIGNATURE_SECRET=
# Shared secret for X-Ops-Api-Key on /api/collect and /api/ops/*.
OPS_API_KEY=
COLLECT_API_KEY=
# Shared rate-limit state and cache coordination
REDIS_URL=

# Auth0 developer login (Regular Web Application) — developers log in at /developers
# and mint their own x-api-key. See "Operational Security & API Access" in README.
AUTH0_DOMAIN=
AUTH0_LOGIN_CLIENT_ID=
AUTH0_LOGIN_CLIENT_SECRET=
# Auth0 API identifier requested as the access-token audience (server-only)
AUTH0_AUDIENCE=https://api.datosbizi.com
# Comma-separated direct OAuth clients accepted at the API boundary.
AUTH0_ACCESS_TOKEN_ALLOWED_CLIENT_IDS=
# Additional single client ID for the MCP Custom API Client that performs the
# Auth0 On-Behalf-Of exchange. Do not put its secret in this application.
MCP_AUTH0_OBO_CLIENT_ID=
# Random string, min 32 chars, used to encrypt the developer login session cookie
SESSION_SECRET=

# Sentry build-time options (source maps + release). Set in CI/build, not runtime.
# VITE_SENTRY_ORG=
# VITE_SENTRY_PROJECT=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Suscripciones por email del informe mensual (Resend, https://resend.com)
# Clave de API de Resend (https://resend.com/api-keys). Sin ella, el envío de
# informes a suscriptores degrada a "no configurado" y no se envía nada.
RESEND_API_KEY=
# Remitente. Debe usar un dominio verificado en https://resend.com/domains
# (p. ej. "DatosBizi <informes@datosbizi.com>").
EMAIL_FROM=
# Opcional: Reply-To de los correos transaccionales
EMAIL_REPLY_TO=

# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"
