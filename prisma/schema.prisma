// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Station {
  id        String   @id
  name      String
  lat       Float
  lon       Float
  capacity  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statuses      StationStatus[]
  hourlyStats   HourlyStationStat[]
  dailyStats    DailyStationStat[]
  rankings      StationRanking[]
  patterns      StationPattern[]
  heatmapCells  StationHeatmapCell[]
  alerts        StationAlert[]
  criticalEpisodes StationCriticalEpisode[]

  @@index([isActive])
  @@index([lat, lon])
}

model StationStatus {
  id              Int      @id @default(autoincrement())
  stationId       String
  bikesAvailable  Int
  anchorsFree     Int
  recordedAt      DateTime // Snapshot timestamp from GBFS response last_updated
  createdAt       DateTime @default(now()) // When we recorded it

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, recordedAt])
  @@index([recordedAt, stationId, bikesAvailable, anchorsFree]) // Composite for time-range + station queries (critical episodes, rollups); also covers plain recordedAt range scans
}

enum DayType {
  WEEKDAY
  WEEKEND
}

enum AlertType {
  LOW_BIKES
  LOW_ANCHORS
}

model HourlyStationStat {
  stationId      String
  bucketStart    DateTime
  bikesMin       Int
  bikesMax       Int
  bikesAvg       Float
  anchorsMin     Int
  anchorsMax     Int
  anchorsAvg     Float
  occupancyAvg   Float
  sampleCount    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([stationId, bucketStart])
  @@index([bucketStart, stationId]) // Composite for time-range queries with station filter (mobility signals, patterns); also covers plain bucketStart range scans
}

model DailyStationStat {
  stationId      String
  bucketDate     DateTime
  bikesMin       Int
  bikesMax       Int
  bikesAvg       Float
  anchorsMin     Int
  anchorsMax     Int
  anchorsAvg     Float
  occupancyAvg   Float
  sampleCount    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([stationId, bucketDate])
  @@index([bucketDate])
}

// Serie diaria a nivel de red para /api/history. Se calcula una vez por dia a
// partir de los mismos snapshots crudos que StationStatus y guarda las cinco
// metricas ya agregadas, de modo que el endpoint no tenga que escanear la tabla
// cruda (millones de filas) en cada peticion. El dia en curso no se persiste:
// se calcula en vivo y se fusiona con esta serie.
model DailySystemStat {
  day          DateTime @id @db.Date
  demandScore  Int
  avgOccupancy Float
  balanceIndex Float
  sampleCount  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StationRanking {
  id            Int      @id @default(autoincrement())
  stationId     String
  turnoverScore Float
  emptyHours    Int
  fullHours     Int
  totalHours    Int
  windowStart   DateTime
  windowEnd     DateTime
  updatedAt     DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([windowEnd, stationId]) // For latest-window queries (getStationRankings)
  @@unique([stationId, windowStart, windowEnd])
}

model StationPattern {
  stationId    String
  dayType      DayType
  hour         Int
  bikesAvg     Float
  anchorsAvg   Float
  occupancyAvg Float
  sampleCount  Int

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([stationId, dayType, hour])
}

model StationHeatmapCell {
  stationId    String
  dayOfWeek    Int
  hour         Int
  bikesAvg     Float
  anchorsAvg   Float
  occupancyAvg Float
  sampleCount  Int

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([stationId, dayOfWeek, hour])
}

model StationAlert {
  id           Int       @id @default(autoincrement())
  stationId    String
  alertType    AlertType
  severity     Int
  metricValue  Float
  windowHours  Int
  generatedAt  DateTime  @default(now())
  isActive     Boolean   @default(true)

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([generatedAt])
  @@index([isActive, generatedAt]) // For active alerts queries (getActiveAlerts)
  @@unique([stationId, alertType, windowHours, generatedAt])
}

model AnalyticsWatermark {
  name             String   @id
  lastAggregatedAt DateTime?
  updatedAt        DateTime @updatedAt
}

model MobilityBriefingCache {
  dateKey       String   @id
  payload       Json
  sourceLastDay DateTime?
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([generatedAt])
}

// PDF publico del informe mensual: se genera una vez al sellar el mes y se
// sirve tal cual desde /api/reports?format=pdf. La clave es el mes (YYYY-MM);
// no hay expiracion porque un mes cerrado es inmutable.
model MonthlyReportPdf {
  monthKey    String   @id
  bytes       Bytes
  byteSize    Int
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Snapshot JSON del informe mensual ya ensamblado. Es la cache L2: Redis sigue
// siendo la L1, pero si Redis se vacia o se reinicia un mes cerrado se sirve
// desde Postgres sin volver a agregar millones de snapshots crudos.
model MonthlyReportSnapshot {
  monthKey      String   @id
  payload       Json
  schemaVersion Int
  generatedAt   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Rachas exactas (al minuto) sin bicis o sin anclajes, ya extraidas de
// StationStatus. Se recalculan para el mes en curso y al sellar un mes cerrado;
// el informe las lee de aqui y solo cae a la consulta cruda si faltan.
model StationCriticalEpisode {
  id              BigInt   @id @default(autoincrement())
  stationId       String
  kind            String   // 'empty' | 'full'
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Float
  monthKey        String   // YYYY-MM
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, kind, startedAt])
  @@index([monthKey, stationId])
  @@index([startedAt])
}

model JobLock {
  name          String   @id
  lockedAt      DateTime?
  lockExpiresAt DateTime?
  lockedBy      String?
}

model Install {
  id                  String   @id @default(cuid())
  installId           String   @unique
  platform            String
  appVersion          String
  osVersion           String
  publicKey           String
  publicKeyMaterial   String?
  publicKeyFingerprint String   @unique
  refreshTokenHash    String   @unique
  previousRefreshTokenHash String?
  previousRefreshTokenExpiresAt DateTime?
  previousRefreshTokenCiphertext String?
  previousAccessTokenCiphertext String?
  refreshTokenIssuedAt DateTime
  lastSeenAt          DateTime?
  lastAuthAt          DateTime?
  revokedAt           DateTime?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([revokedAt])
}

model CollectionRun {
  id                String   @id @default(cuid())
  collectionId      String   @unique
  requestId         String
  city              String
  trigger           String
  sourceUrl         String
  status            String
  gbfsVersion       String?
  snapshotRecordedAt DateTime?
  expectedStationCount Int?
  insertedCount     Int      @default(0)
  duplicateCount    Int      @default(0)
  warningCount      Int      @default(0)
  errorCount        Int      @default(0)
  warnings          String[] @default([])
  errors            String[] @default([])
  durationMs        Int?
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([startedAt])
  @@index([status, startedAt])
}

model SecurityEvent {
  id           String   @id @default(cuid())
  eventType    String
  route        String
  requestId    String
  installId    String?
  collectionId String?
  ipHash       String?
  userAgentHash String?
  outcome      String
  reasonCode   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
}

enum ReportSubscriptionStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

enum ReportDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// Suscripcion al informe mensual por email (doble opt-in). Los tokens se
// guardan en claro a proposito: son tokens de capacidad de bajo valor (solo
// confirman o dan de baja) y el envio mensual necesita reutilizar el token de
// baja para componer el enlace de cada correo.
model ReportSubscription {
  id               String                   @id @default(cuid())
  email            String                   @unique // normalizado: minusculas y sin espacios
  status           ReportSubscriptionStatus @default(PENDING)
  confirmToken     String                   @unique
  unsubscribeToken String                   @unique
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  deliveries ReportDelivery[]

  @@index([status, confirmedAt])
}

// Control de envios del informe mensual: una fila por suscripcion y mes hace
// el envio idempotente (un run interrumpido o un reintento nunca duplica el
// correo de un mes ya enviado).
model ReportDelivery {
  id             String               @id @default(cuid())
  subscriptionId String
  monthKey       String // YYYY-MM
  status         ReportDeliveryStatus @default(PENDING)
  attempts       Int                  @default(1)
  resendId       String?
  lastError      String?
  claimedAt      DateTime             @default(now())
  sentAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  subscription ReportSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, monthKey])
  @@index([monthKey, status])
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @unique
  keyPrefix   String   // First 8 chars of key for identification
  description String?
  // Account is stored in the fixed identity schema, outside the per-city
  // Prisma search path. The cross-schema foreign key is managed by the
  // migration; do not add an Account relation here or Prisma would resolve it
  // into every city schema.
  accountId   String?
  ownerEmail  String?
  
  // Rate limiting (null = use defaults)
  customRateLimit   Int?     // requests per window
  customRateWindow  Int?     // window in milliseconds
  
  // Usage tracking
  lastUsedAt        DateTime?
  requestCount      Int      @default(0)
  
  // Status
  isActive          Boolean  @default(true)
  revokedAt         DateTime?
  revokedReason     String?
  
  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?  // User/Admin who created this key

  @@index([isActive, revokedAt])
  @@index([keyPrefix])
  @@index([createdAt])
  @@index([accountId, revokedAt])
  @@index([ownerEmail, revokedAt])
}
